# ============================================================================
# 生产环境变量配置模板
# 复制为 .env 后修改所有密码！
# ============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=panjia
POSTGRES_PASSWORD=请改成强密码_至少16位_含大小写数字符号
POSTGRES_DB=panjia

# ---- JKS 密钥密码（必须与生成 JKS 时的密码一致）----
PANJIA_JKS_PASSWORD=请改成JKS密钥库密码
PANJIA_KEY_PASSWORD=请改成JKS密钥密码

# ---- 运营管理员名称 ----
PANJIA_OPERATOR_NAME=admin

# ---- 镜像标签（部署时自动填充）----
IMAGE_TAG=latest

# ---- 前端映射端口（默认 80）----
HOST_PORT=80

# ---- JVM 参数（根据服务器内存调整）----
# 2G 内存服务器：-Xms512m -Xmx1024m
# 4G 内存服务器：-Xms1024m -Xmx2048m
# 8G 内存服务器：-Xms2048m -Xmx4096m
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
