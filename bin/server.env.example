# 复制本文件为 bin/server.env 并填入真实信息（server.env 已被 git 忽略）
# cp bin/server.env.example bin/server.env
#
# 所有 bin/*.sh 部署脚本共享此配置；可用同名环境变量临时覆盖（环境变量 > 本文件）

# ---- 连接 ----
SERVER_IP=你的服务器IP
SERVER_USER=ubuntu

# ---- 部署 ----
INSTALL_DIR=/opt/panjia-console     # 服务器上的安装目录
IMAGE_TAG=v1                        # 后端镜像默认标签

# ---- 域名 / 证书 ----
DOMAIN=你的域名
CERT_EMAIL=admin@你的域名
