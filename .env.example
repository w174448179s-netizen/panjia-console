# ===== 环境变量示例（本地开发）=====
# 复制为 .env 后修改实际值
# 启动脚本会自动读取项目根目录下的 .env 文件

# ---- 数据库（容器内用 host.docker.internal 访问宿主机 PG）----
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/postgres?TimeZone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ---- JKS 密钥（开发环境默认密码，生产必须替换）----
PANJIA_JKS_PASSWORD=devpass123456
PANJIA_KEY_PASSWORD=devpass123456

# ---- 运营配置 ----
PANJIA_OPERATOR_NAME=admin

# ---- 本地端口映射 ----
PANJIA_BACKEND_PORT=8081
PANJIA_FRONTEND_PORT=3000
